{
  "name": "emolysis-integrations",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "check:configs": "node scripts/check-configs.mjs",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p tsconfig.json",
    "test": "pnpm -r --if-present run test && vitest run",
    "build": "pnpm -r --if-present run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "smol-toml": "^1.9.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
